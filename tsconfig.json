{
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "chrome",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
